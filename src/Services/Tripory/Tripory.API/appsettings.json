{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": []
  },
  "JwtOptions": {
    "Issuer": "TriporyBackend",
    "Audience": "TriporyClientApp",
    "ExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 7
  },
  "DestinationCatalog": {
    "CoverImageBaseUrl": "https://triporyv1.vercel.app/destinations/"
  }
}
